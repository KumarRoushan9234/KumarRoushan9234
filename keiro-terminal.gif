
<svg width="1400" height="620"
     viewBox="0 0 1400 620"
     xmlns="http://www.w3.org/2000/svg">

  <defs>

    <linearGradient id="terminalBg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#070B11"/>
      <stop offset="100%" stop-color="#0B111A"/>
    </linearGradient>

    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#60A5FA"/>
    </linearGradient>

    <filter id="glow">
      <feGaussianBlur stdDeviation="4"/>
    </filter>

  </defs>

  <!-- Main terminal window -->

  <rect x="20"
        y="20"
        width="1360"
        height="580"
        rx="16"
        fill="url(#terminalBg)"
        stroke="#1E293B"
        stroke-width="2"/>

  <!-- Terminal title bar -->

  <rect x="20"
        y="20"
        width="1360"
        height="52"
        rx="16"
        fill="#0F1720"/>

  <line x1="20"
        y1="72"
        x2="1380"
        y2="72"
        stroke="#1E293B"/>

  <!-- Window controls -->

  <circle cx="52" cy="46"
          r="7"
          fill="#EF4444"/>

  <circle cx="77" cy="46"
          r="7"
          fill="#F59E0B"/>

  <circle cx="102" cy="46"
          r="7"
          fill="#22C55E"/>

  <text x="650"
        y="51"
        text-anchor="middle"
        fill="#64748B"
        font-family="JetBrains Mono, monospace"
        font-size="12">
    keirolabs — terminal
  </text>

  <!-- Command -->

  <text x="55"
        y="115"
        fill="#60A5FA"
        font-family="JetBrains Mono, monospace"
        font-size="15">
    $
  </text>

  <text x="75"
        y="115"
        fill="#E2E8F0"
        font-family="JetBrains Mono, monospace"
        font-size="15">
    curl https://api.keirolabs.cloud/v2/search \
  </text>

  <text x="75"
        y="140"
        fill="#CBD5E1"
        font-family="JetBrains Mono, monospace"
        font-size="15">
    -d '{"query":"latest AI agent infrastructure"}'
  </text>

  <!-- Cursor -->

  <rect x="540"
        y="102"
        width="8"
        height="19"
        fill="#60A5FA">

    <animate
      attributeName="opacity"
      values="1;0;1"
      dur="1s"
      repeatCount="indefinite"/>

  </rect>

  <!-- Divider -->

  <line x1="55"
        y1="165"
        x2="1345"
        y2="165"
        stroke="#1E293B"/>

  <!-- Processing steps -->

  <g font-family="JetBrains Mono, monospace"
     font-size="14">

    <!-- Step 1 -->

    <text x="60" y="205" fill="#38BDF8">
      →
    </text>

    <text x="85" y="205" fill="#94A3B8">
      Initializing request...
    </text>

    <text x="460" y="205" fill="#22C55E">
      [ OK ]
    </text>

    <!-- Step 2 -->

    <text x="60" y="240" fill="#38BDF8">
      →
    </text>

    <text x="85" y="240" fill="#94A3B8">
      Classifying query...
    </text>

    <text x="460" y="240" fill="#22C55E">
      [ OK ]
    </text>

    <!-- Step 3 -->

    <text x="60" y="275" fill="#38BDF8">
      →
    </text>

    <text x="85" y="275" fill="#94A3B8">
      Searching web...
    </text>

    <text x="460" y="275" fill="#22C55E">
      [ OK ]
    </text>

    <!-- Step 4 -->

    <text x="60" y="310" fill="#38BDF8">
      →
    </text>

    <text x="85" y="310" fill="#94A3B8">
      Extracting content...
    </text>

    <text x="460" y="310" fill="#22C55E">
      [ OK ]
    </text>

    <!-- Step 5 -->

    <text x="60" y="345" fill="#38BDF8">
      →
    </text>

    <text x="85" y="345" fill="#94A3B8">
      Ranking results...
    </text>

    <text x="460" y="345" fill="#22C55E">
      [ OK ]
    </text>

    <!-- Step 6 -->

    <text x="60" y="380" fill="#38BDF8">
      →
    </text>

    <text x="85" y="380" fill="#94A3B8">
      Generating structured response...
    </text>

    <text x="460" y="380" fill="#22C55E">
      [ OK ]
    </text>

  </g>

  <!-- Animated processing pulse -->

  <circle cx="530"
          cy="380"
          r="5"
          fill="#38BDF8">

    <animate
      attributeName="r"
      values="5;10;5"
      dur="1.4s"
      repeatCount="indefinite"/>

    <animate
      attributeName="opacity"
      values="1;0.2;1"
      dur="1.4s"
      repeatCount="indefinite"/>

  </circle>

  <!-- Success -->

  <text x="60"
        y="430"
        fill="#22C55E"
        font-family="JetBrains Mono, monospace"
        font-size="15">
    ✓ Response generated successfully.
  </text>

  <!-- JSON response -->

  <text x="60"
        y="465"
        fill="#64748B"
        font-family="JetBrains Mono, monospace"
        font-size="13">
    {
  </text>

  <text x="80"
        y="490"
        fill="#CBD5E1"
        font-family="JetBrains Mono, monospace"
        font-size="13">
    "query": "latest AI agent infrastructure",
  </text>

  <text x="80"
        y="515"
        fill="#CBD5E1"
        font-family="JetBrains Mono, monospace"
        font-size="13">
    "results": [...],
  </text>

  <text x="80"
        y="540"
        fill="#CBD5E1"
        font-family="JetBrains Mono, monospace"
        font-size="13">
    "sources": 12,
  </text>

  <text x="80"
        y="565"
        fill="#CBD5E1"
        font-family="JetBrains Mono, monospace"
        font-size="13">
    "status": "complete"
  </text>

  <text x="60"
        y="590"
        fill="#64748B"
        font-family="JetBrains Mono, monospace"
        font-size="13">
    }
  </text>

  <!-- Right-side Keiro information -->

  <line x1="720"
        y1="105"
        x2="720"
        y2="575"
        stroke="#1E293B"/>

  <!-- Logo -->

  <g transform="translate(775 135)">

    <path
      d="M0 55 L28 0 L58 0 L35 55 Z"
      fill="url(#accent)"/>

    <path
      d="M25 34 L62 55 L40 55 L7 35 Z"
      fill="#93C5FD"/>

    <path
      d="M34 25 L58 3 L80 3 L48 38 Z"
      fill="#2563EB"/>

    <path
      d="M45 35 L80 55 L59 55 L32 40 Z"
      fill="#60A5FA"/>

  </g>

  <text x="875"
        y="155"
        fill="#F8FAFC"
        font-family="Inter, Arial, sans-serif"
        font-size="30"
        font-weight="700">
    KeiroLabs
  </text>

  <text x="875"
        y="180"
        fill="#64748B"
        font-family="JetBrains Mono, monospace"
        font-size="11">
    AI INFRASTRUCTURE PLATFORM
  </text>

  <!-- Product capabilities -->

  <g font-family="JetBrains Mono, monospace"
     font-size="13">

    <text x="775" y="245" fill="#60A5FA">
      &gt; Real-time Search APIs
    </text>

    <text x="775" y="280" fill="#94A3B8">
      &gt; Browser Infrastructure
    </text>

    <text x="775" y="315" fill="#94A3B8">
      &gt; Content Extraction
    </text>

    <text x="775" y="350" fill="#94A3B8">
      &gt; Retrieval &amp; RAG Systems
    </text>

    <text x="775" y="385" fill="#94A3B8">
      &gt; Agentic Research
    </text>

    <text x="775" y="420" fill="#94A3B8">
      &gt; Developer SDKs
    </text>

    <text x="775" y="455" fill="#94A3B8">
      &gt; MCP Integrations
    </text>

  </g>

  <!-- Product tagline -->

  <line x1="775"
        y1="490"
        x2="1275"
        y2="490"
        stroke="#1E293B"/>

  <text x="775"
        y="525"
        fill="#64748B"
        font-family="JetBrains Mono, monospace"
        font-size="12">
    Search. Browse. Extract. Retrieve.
  </text>

  <text x="775"
        y="550"
        fill="#60A5FA"
        font-family="JetBrains Mono, monospace"
        font-size="12">
    keirolabs.cloud
  </text>

  <!-- Animated bottom cursor -->

  <rect x="775"
        y="570"
        width="9"
        height="15"
        fill="#60A5FA">

    <animate
      attributeName="opacity"
      values="1;0;1"
      dur="1s"
      repeatCount="indefinite"/>

  </rect>

</svg>
